-- Noclip (сквозь стены)
local noclipBtn = createBtn("Noclip: Выкл", 3)
local noclipOn = false
noclipBtn.MouseButton1Click:Connect(function()
    noclipOn = not noclipOn
    noclipBtn.Text = noclipOn and "Noclip: Вкл" or "Noclip: Выкл"
    noclipBtn.BackgroundColor3 = noclipOn and Color3.fromRGB(45, 120, 45) or Color3.fromRGB(45, 45, 65)
end)

RunService.Stepped:Connect(function()
    if noclipOn and character then
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end
end)

-- Полет (Fly)
local flyBtn = createBtn("Полет: Выкл", 4)
local flying = false
local bodyVelocity, bodyGyro

flyBtn.MouseButton1Click:Connect(function()
    flying = not flying
    flyBtn.Text = flying and "Полет: Вкл" or "Полет: Выкл"
    flyBtn.BackgroundColor3 = flying and Color3.fromRGB(45, 120, 45) or Color3.fromRGB(45, 45, 65)

    if flying then
        bodyVelocity = Instance.new("BodyVelocity")
        bodyVelocity.MaxForce = Vector3.new(1e5, 1e5, 1e5)
        bodyVelocity.Velocity = Vector3.zero
        bodyVelocity.Parent = rootPart

        bodyGyro = Instance.new("BodyGyro")
        bodyGyro.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
        bodyGyro.CFrame = rootPart.CFrame
        bodyGyro.Parent = rootPart

        task.spawn(function()
            while flying do
                local camera = workspace.CurrentCamera
                bodyGyro.CFrame = camera.CFrame
                bodyVelocity.Velocity = camera.CFrame.LookVector * 50
                task.wait()
            end
        end)
    else
        if bodyVelocity then bodyVelocity:Destroy() end
        if bodyGyro then bodyGyro:Destroy() end
    end
end)

